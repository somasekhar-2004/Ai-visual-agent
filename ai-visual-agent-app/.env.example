# Copy this file to .env and set this to your backend's LAN URL - the same one you'd use to test
# Termino from a physical device: find your Mac's LAN IP (System Settings -> Wi-Fi -> Details, or
# `ipconfig getifaddr en0` in Terminal) and point this at the Next.js dev server's port.
#
# Your phone and your Mac must be on the same Wi-Fi network for this to work - a plain
# `localhost`/`127.0.0.1` URL here would only work from a simulator running on the Mac itself.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:3000
