# AI Visual Expert - environment configuration
# Copy this file to .env.local and fill in real values for production use.
# With no values set, the app runs entirely on the built-in mock vision provider
# (see src/lib/vision/mockProvider.ts) so the camera/overlay/voice experience can be
# developed and tested without spending any API credits.

# Which VisionProvider implementation to use: "mock" | "gemini" | "anthropic"
# Leave unset to auto-detect from whichever key below is present (GEMINI_API_KEY is checked
# first, then VISION_API_KEY), falling back to "mock" if neither is set.
VISION_PROVIDER=mock

# Google AI Studio API key - used by the "gemini" provider (real image understanding, circuit/
# component detection, bounding boxes, and path-style highlighting for wires). Get one at
# https://aistudio.google.com/apikey. NEVER exposed to the client - only read server-side
# inside the /api/analyze and /api/verify route handlers.
GEMINI_API_KEY=

# API key for the Anthropic vision provider (used only if VISION_PROVIDER=anthropic, or as a
# fallback when GEMINI_API_KEY isn't set). Also never exposed to the client.
VISION_API_KEY=

# Provider-specific model id, e.g. gemini-2.5-flash (Gemini) or claude-sonnet-5 (Anthropic).
# Optional - each provider implementation has its own sensible default.
VISION_MODEL=
