# Copy this file to .env and fill in the values you have. Every value is
# optional — the app runs fully in Demo Mode with zero configuration.

# --- Supabase ------------------------------------------------------------
# Leave both blank to run in Demo Mode (local on-device storage, seeded with
# a demo user "Alex"). Fill in both to use a real backend.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — used by scripts/run-migrations.js and scripts/run-seed.js.
# Get this from Supabase: Project Settings > Database > Connection string (URI).
# NEVER prefix this with EXPO_PUBLIC_ and never ship it in the mobile bundle.
DATABASE_URL=
# Project Settings > API > service_role key. Used only by scripts/run-seed.js
# to create the demo auth user server-side.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider -----------------------------------------------------------
# "mock" (default) needs no key and runs entirely on-device with realistic
# heuristic feedback. Set to "openai" or "anthropic" plus the matching key
# below to use a real model for Writing/Speaking evaluation and the AI Coach.
EXPO_PUBLIC_AI_PROVIDER=mock
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-sonnet-5

# --- RevenueCat (subscriptions) --------------------------------------------
# Leave blank to run the paywall in mock mode (simulated purchases, no store
# calls). Get these from the RevenueCat dashboard once you've set up
# App Store Connect / Google Play products.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
