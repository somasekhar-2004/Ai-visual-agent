# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
dist-artifact.html
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Piper TTS voice models (large binary files, downloaded locally by
# `python3 -m piper.download_voices` for scripts/generate-audio.ts — never
# bundled into the app, so never committed).
.piper-voices/

# typescript
*.tsbuildinfo

# Deno (supabase/functions/_shared/aiProviders.test.ts) — auto-generated
# lockfile covering the whole npm dependency graph when run from repo root;
# not needed to reproduce `deno check`/`deno lint`/`deno test`.
deno.lock

# generated native folders
/ios
/android

# Supabase CLI local cache/state (npx supabase ...) — machine-local, never
# holds anything the app or its migrations need; recreated automatically.
supabase/.temp/
