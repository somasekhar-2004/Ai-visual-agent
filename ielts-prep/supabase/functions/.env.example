# These are NOT read from a .env file — Supabase Edge Functions read
# secrets from their own managed environment, set with the Supabase CLI:
#
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set GEMINI_API_KEY=AIza...
#   supabase secrets set AI_PROVIDER=openai
#
# (run each from the repo root, once your project is linked — see
# "Deploying the Edge Functions" in README.md for the full setup sequence.)
#
# This file exists purely as documentation of what to set and why — copying
# it to functions/.env and running the functions locally would also work
# (`supabase functions serve --env-file supabase/functions/.env`), but never
# commit a real .env file here.
#
# SUPABASE_URL and SUPABASE_ANON_KEY are NOT listed below because Supabase
# injects them automatically into every function's runtime — setting them
# yourself via `supabase secrets set` is rejected as a reserved name.

# --- AI provider (server-only secret) --------------------------------------
# At least one of these three keys must be set for real AI evaluation to turn
# on. With none set, every Edge Function returns a clean "ai_not_configured"
# response and the app automatically falls back to its on-device mock
# provider — Demo Mode-quality feedback, but the app keeps working normally
# either way.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Free-tier Gemini Developer API key — create one at
# https://aistudio.google.com/apikey. Supports Writing evaluation, Speaking
# evaluation, AI Coach, study-plan suggestion, AND audio transcription (via
# the general generateContent endpoint with inline audio, not the separate
# non-free "gemini-3.5-transcribe" model).
GEMINI_API_KEY=

# Which provider to prefer when more than one key is set: openai | anthropic
# | gemini. "openai" (default) is also preferred for audio transcription when
# both an OpenAI and a Gemini key are set — Anthropic still has no audio API
# at all, so with only ANTHROPIC_API_KEY set, transcription falls back to the
# client's simulated transcript (same as no key at all).
AI_PROVIDER=openai

# Optional model overrides — sensible defaults are used if unset.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5
# gemini-2.0-flash is on the free Gemini Developer API tier as of this
# writing — check https://ai.google.dev/pricing before relying on this
# default in production; it may need to change as Google's model lineup and
# free-tier terms evolve.
GEMINI_MODEL=gemini-2.0-flash
# Model used specifically for Gemini audio transcription — defaults to
# GEMINI_MODEL above if unset. Override independently if you want
# transcription on a different (e.g. more audio-accurate) model without
# changing the model used for Writing/Speaking eval, AI Coach, and the study
# plan note.
GEMINI_TRANSCRIBE_MODEL=
