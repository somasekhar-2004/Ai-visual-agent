# These are NOT read from a .env file — Supabase Edge Functions read
# secrets from their own managed environment, set with the Supabase CLI:
#
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set AI_PROVIDER=openai
#
# (run each from the repo root, once your project is linked — see
# "Deploying the Edge Functions" in README.md for the full setup sequence.)
#
# This file exists purely as documentation of what to set and why — copying
# it to functions/.env and running the functions locally would also work
# (`supabase functions serve --env-file supabase/functions/.env`), but never
# commit a real .env file here.
#
# SUPABASE_URL and SUPABASE_ANON_KEY are NOT listed below because Supabase
# injects them automatically into every function's runtime — setting them
# yourself via `supabase secrets set` is rejected as a reserved name.

# --- AI provider (server-only secret) --------------------------------------
# At least one of these two keys must be set for real AI evaluation to turn
# on. With neither set, every Edge Function returns a clean
# "ai_not_configured" response and the app automatically falls back to its
# on-device mock provider — Demo Mode-quality feedback, but the app keeps
# working normally either way.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider to prefer when both keys are set. "openai" (default) is
# also required for audio transcription — Anthropic has no speech-to-text
# API, so with only ANTHROPIC_API_KEY set, transcription falls back to the
# client's simulated transcript (same as no key at all).
AI_PROVIDER=openai

# Optional model overrides — sensible defaults are used if unset.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5
